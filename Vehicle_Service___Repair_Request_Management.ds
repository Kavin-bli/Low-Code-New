 application "Vehicle Service & Repair Request Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Service_Request_Form
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Owner_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Vehicle_Registration_Number
			(
    			type = text
				displayname = "Vehicle Registration Number"
				maxchar = 15
	 			row = 1
	 			column = 1   
				width = medium
			)
			Vehicle_Type
			(
				type = picklist
				displayname = "Vehicle Type"
				maxchar = 100
				values = {"Hatchback","Sedan","SUV","MUV","Luxury Car","Electric Vehicle","Motorcycle","Scooter","Van","Truck"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Request_ID
			(
				type = number
				displayname = "Service Request ID"
				maxchar = 5
	 			row = 1
	 			column = 1   
				width = medium
			)
			Owner_Email
			(
    			type = email
				displayname = "Owner Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Vehicle_Type1
			(
				type = picklist
				displayname = "Vehicle Type"
				maxchar = 100
				values = {"Two Wheeler","Four Wheeler","Commercial Vehicle"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Type
			(
				type = picklist
				displayname = "Service Type"
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Service_Date
			(
    			type = date
				displayname = "Preferred Service Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Service_Request_Submitted_On
			(
    			type = datetime
				displayname = "Service Request Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pickup_Address
			(
    			type = address
				displayname = "Pickup Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Choice 1","Choice 2","Choice 3"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Cost
			(
				type = decimal
				displayname = "Estimated Cost"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Insurance_Copy
			(
    			type = upload file
				displayname = "Insurance Copy"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Damage_Photos
			(
    			type = image
				displayname = "Damage Photos"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Status
			(
				type = picklist
				displayname = "Repair Status"
				maxchar = 100
				values = {"Pending","In Progress","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Owner_Phone
			(
    			type = phonenumber
				displayname = "Owner Phone"
	 			row = 1
	 			column = 2   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Service_Request_Form_Report
		{
			displayName = "Service_Request_Form Report"
			show all rows from Service_Request_Form    
			(
				Owner_Name 
				Vehicle_Registration_Number as "Vehicle Registration Number"
				Vehicle_Type as "Vehicle Type"
				Owner_Phone as "Owner Phone"
				(
					displayformat = plainnumber 
				)
				Service_Request_ID as "Service Request ID"
				Owner_Email as "Owner Email"
				Vehicle_Type1 as "Vehicle Type"
				Service_Type as "Service Type"
				Preferred_Service_Date as "Preferred Service Date"
				Service_Request_Submitted_On as "Service Request Submitted On"
				Pickup_Address  as "Pickup Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Status
				Estimated_Cost as "Estimated Cost"
				Insurance_Copy as "Insurance Copy"
				Damage_Photos as "Damage Photos"
				Repair_Status as "Repair Status"
			)
		}
